# Python environment and generated bytecode.
.venv/
__pycache__/
*.py[cod]

# Local source documents, models and spreadsheets.
*.pkl
*.xlsx
*.pdf

# Application data and backups stay on the workstation.
data/*.db
data/*.db-wal
data/*.db-shm
backups/
llm_cache/

# Generated audit evidence; publish the written review separately.
analysis_outputs/*_extracted.txt
analysis_outputs/*_program_result.json
analysis_outputs/page_*.png
analysis_outputs/_validate_*.py
